# ---------------------------------------------------------------------------
# Copy to `.env` for local runs (`npm run dev`).
# On Render these are set as Environment Variables / Secrets on the service —
# never commit real secrets.
# ---------------------------------------------------------------------------

# --- Odoo CRM (external API) ---
ODOO_URL=https://yourcompany.odoo.com
ODOO_DB=yourcompany
ODOO_USERNAME=bot@yourcompany.com
ODOO_API_KEY=replace-with-odoo-api-key
# Odoo salesperson (res.users id) used when a Terros rep can't be mapped
ODOO_FALLBACK_USER_ID=2
# Stage names in your Odoo pipeline (must match crm.stage names exactly)
ODOO_STAGE_NEW=New
ODOO_STAGE_BOOKED=Booked
ODOO_STAGE_QUOTED=Quoted
ODOO_STAGE_WON=Won
ODOO_STAGE_LOST=Lost

# --- Terros (REST + webhooks) ---
# Auth is sent as `Authorization: ApiKey <key>`. Base URL is https://api.terros.com
TERROS_BASE_URL=https://api.terros.com
TERROS_API_KEY=replace-with-terros-api-key
# Terros webhooks are not signed — protect the endpoint with a secret token in
# the URL path. Register the webhook URL in Terros as:
#   https://<your-app>.onrender.com/webhooks/terros/<TERROS_WEBHOOK_TOKEN>
TERROS_WEBHOOK_TOKEN=generate-a-long-random-string

# --- Paradigm Vendo ---
# Public API (Create Appointment): Public + Private key pair from
# Advanced Settings → Public API. Confirm the base URL with Paradigm's API doc.
VENDO_BASE_URL=https://api.paradigmvendo.com
VENDO_PUBLIC_KEY=replace-with-vendo-public-key
VENDO_PRIVATE_KEY=replace-with-vendo-private-key
# Inbound Appointment Result webhook auth: add a matching custom header in
# Vendo (Advanced Settings → Webhooks → Add Header).
VENDO_WEBHOOK_AUTH_HEADER=x-webhook-token
VENDO_WEBHOOK_TOKEN=generate-a-long-random-string

# --- Runtime ---
PORT=3000
LOG_LEVEL=info
