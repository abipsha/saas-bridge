{
  "name": "saas-bridge",
  "version": "0.1.0",
  "description": "Integration bot connecting Terros, Paradigm Vendo, and Odoo CRM — deploys on Render",
  "license": "UNLICENSED",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
